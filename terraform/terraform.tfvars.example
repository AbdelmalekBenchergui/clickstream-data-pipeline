# AWS
aws_region = "us-east-1"
environment = "dev"

# S3 (bucket names must be globally unique)
raw_bucket_name    = "clickstream-raw-XXXXXXXXXXXX"
silver_bucket_name = "clickstream-silver-XXXXXXXXXXXX"
gold_bucket_name   = "clickstream-gold-XXXXXXXXXXXX"

# EC2
ami_id = "ami-xxxxxxxxxxxxxxxxx"
instance_type = "t3.micro"
key_name = "your-key-pair-name"
ssh_allowed_cidr = "0.0.0.0/0"
instance_count = 1

# Glue
glue_database = "clickstream_db"

# IAM
producer_role_name = "clickstream-producer-role"
glue_role_name = "clickstream-glue-role"
